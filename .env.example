# Backend the Vite dev server proxies API requests to.
# In development the frontend calls same-origin paths (/api, /health) and Vite
# forwards them here, so CORS is never involved. Override only if your backend
# does not run on the default local port.
VITE_API_URL=http://localhost:5080

# Public URL of the app, used as the base of the deep links encoded into QR
# codes: each location's QR points at `${VITE_PUBLIC_APP_URL}/l/{qrSlug}`.
# In development this is the Vite dev server. Set it to the production URL when
# deploying (the browser camera scanner requires HTTPS in production).
# When left unset the app falls back to the current window origin.
VITE_PUBLIC_APP_URL=http://localhost:3000

# VAPID public key for Web Push notifications (Phase 13).
# Generate a key pair on the backend with: npx web-push generate-vapid-keys
# Set the public key here and the private key only on the backend.
# Leave unset to disable push notifications (email-only mode still works).
VITE_VAPID_PUBLIC_KEY=
